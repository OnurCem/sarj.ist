{
  "name": "sarj-ist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:data && astro dev --host 127.0.0.1",
    "validate:data": "node scripts/ensure-station-data.mjs && node scripts/validate-stations.mjs",
    "prepare:data": "node scripts/ensure-station-data.mjs && node scripts/build-station-data.mjs",
    "fetch:epdk": "node scripts/fetch-epdk.mjs",
    "import:epdk": "node scripts/import-epdk.mjs",
    "sync:epdk": "npm run fetch:epdk && npm run import:epdk -- --input data/raw/epdk-latest.json",
    "check:deployment": "node scripts/check-deployment-size.mjs",
    "deploy:dry-run": "npm run build && npm run check:deployment && wrangler deploy --dry-run",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "recover:deployment-state": "node scripts/bootstrap-state-from-deployment.mjs",
    "test": "node --test",
    "build": "npm run validate:data && npm run prepare:data && astro build",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "astro": "^7.3.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  },
  "devDependencies": {
    "wrangler": "^4.129.1"
  }
}
