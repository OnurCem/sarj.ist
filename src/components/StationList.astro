---
import { operatorBadgeLabel } from '../lib/station-presentation.mjs';
const { stations } = Astro.props;
---
<div class="city-station-list">
  {stations.map((station) => (
    <a class="city-station-row" href={`/istasyon/${station.slug}/`}>
      <span class="operator-mark" aria-label={station.operator}>{operatorBadgeLabel(station.operator)}</span>
      <span class="city-station-copy"><strong>{station.name}</strong><small>{station.area}</small><small>{station.access}</small></span>
      <span class="city-station-power"><strong>{station.type} {station.power} kW</strong><small>{station.sockets} soket</small></span>
      <span aria-hidden="true">→</span>
    </a>
  ))}
</div>
