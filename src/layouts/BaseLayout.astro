---
import '../styles/global.css';
import '../styles/theme.css';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  breadcrumbs?: { name: string; path: string }[];
}

const { title, description, canonicalPath = Astro.url.pathname, breadcrumbs } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const breadcrumbJson = breadcrumbs && JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map(({ name, path }, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name,
    item: new URL(path, Astro.site ?? Astro.url.origin).href,
  })),
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#131612" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {breadcrumbJson && <script type="application/ld+json" set:html={breadcrumbJson} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;650;700&family=Manrope:wght@400;500;600;650;700;750;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <SiteFooter />
  </body>
</html>
