---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dataset } from '../data/stations';
import { datasetPresentation } from '../lib/station-presentation.mjs';

const dataView = datasetPresentation(dataset);
---
<BaseLayout title="şarj.ist — Şarjını bul. Yoluna bak." description="Türkiye'deki elektrikli araç şarj istasyonlarını keşfet. Harita, soket ve operatör filtreleriyle şarj durağını bul.">
    <svg class="sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="socket" viewBox="0 0 24 24"><path d="M7 3h10l4 6-3 11H6L3 9Z"/><circle cx="9" cy="8" r="1"/><circle cx="15" cy="8" r="1"/><circle cx="8" cy="13" r="1"/><circle cx="16" cy="13" r="1"/><circle cx="12" cy="16" r="1"/></symbol><symbol id="plus" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"/></symbol><symbol id="minus" viewBox="0 0 24 24"><path d="M5 12h14"/></symbol><symbol id="search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></symbol>
      <symbol id="arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
      <symbol id="pin" viewBox="0 0 24 24"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2"/></symbol>
      <symbol id="bolt" viewBox="0 0 24 24"><path d="m13 2-9 12h7l-1 8 10-13h-8z"/></symbol>
      <symbol id="target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3"/></symbol>
      <symbol id="filter" viewBox="0 0 24 24"><path d="M4 7h16M4 17h16M8 4v6m8 4v6"/></symbol>
      <symbol id="chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></symbol>
      <symbol id="navigate" viewBox="0 0 24 24"><path d="m21 3-7 18-3-8-8-3Z"/></symbol>
      <symbol id="plug" viewBox="0 0 24 24"><path d="M8 3v5m8-5v5M6 8h12v4a6 6 0 0 1-12 0Zm6 10v4"/></symbol>
      <symbol id="close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></symbol>
    </svg>
    <header class="topbar">
      <a class="brand" href="/" aria-label="şarj.ist ana sayfa"><img src="/brand/mark.svg?v=3" width="39" height="39" alt=""/><span>şarj<span class="brand-light">.ist</span></span></a>
      <nav aria-label="Ana menü"><span class="nav-current">İstasyonları keşfet</span><button id="about-button">Nasıl çalışır?</button></nav>
      <div class="header-right"><span class="demo-badge" id="dataset-badge">{dataView.badge}</span></div>
    </header>
    <main class="workspace">
      <aside class="sidebar" aria-label="İstasyon arama ve sonuçları">
        <section class="search-section">
          
          <h1>Şarjını bul.<br/>Yoluna bak.</h1>
          <p id="city-intro">İstanbul’daki şarj noktalarını keşfet.</p>
          <label class="city-picker"><span>Şehir seç</span><select id="region-select" aria-label="Şehir seç"><option value="istanbul">İstanbul</option></select></label>
          <label class="searchbox"><svg><use href="#search"/></svg><input id="search-input" type="search" placeholder="İlçe, istasyon veya operatör ara" aria-label="İstasyon ara"/></label>
          <div class="quick-filters" aria-label="Şarj türü"><button class="chip active" data-type="all" aria-pressed="true">Tümü</button><button class="chip" data-type="DC" aria-pressed="false"><svg><use href="#bolt"/></svg>DC · Hızlı</button><button class="chip" data-type="AC" aria-pressed="false"><svg><use href="#plug"/></svg>AC</button><button class="chip filter-button" id="filters-button" aria-expanded="false" aria-controls="extra-filters" aria-label="Diğer filtreler"><svg><use href="#filter"/></svg></button></div>
          <div id="extra-filters" hidden><label>Operatör<select id="operator"><option value="all">Tüm operatörler</option></select></label><label class="check-label"><input type="checkbox" id="private"/>Özel erişimli istasyonları dahil et</label></div>
        </section>
        <div class="results-heading"><h2 id="region-heading">İstanbul</h2><span id="result-count"></span></div>
        <div class="station-list" id="station-list" aria-live="polite"><div class="empty">İstasyonlar yükleniyor…</div></div>
        <footer class="data-note"><p id="data-note-text">{dataView.summary}</p></footer>
      </aside>
      <section class="map-region" aria-label="Şarj istasyonları haritası">
        <div id="map"></div>
        <div class="map-top"><div class="location-pill"><svg><use href="#pin"/></svg><strong id="map-region-name">İstanbul, Türkiye</strong></div><button id="reset-map" class="map-action" aria-label="İstasyonları göster"><svg><use href="#target"/></svg></button></div>
        
        <div class="map-controls"><button id="zoom-in" aria-label="Haritayı yakınlaştır"><svg><use href="#plus"/></svg></button><button id="zoom-out" aria-label="Haritayı uzaklaştır"><svg><use href="#minus"/></svg></button></div>
        <div class="map-legend"><span><i class="dc-dot"></i>DC hızlı şarj</span><span><i class="ac-dot"></i>AC şarj</span></div>
        <article id="station-detail" class="detail-card" hidden aria-label="İstasyon detayları"></article>
        <div id="map-error" class="map-error" hidden>Harita yüklenemedi. İstasyonları listeden inceleyebilirsin.</div>
      </section>
      <button id="mobile-toggle" class="mobile-toggle"><svg><use href="#pin"/></svg><span>Haritayı göster</span></button>
    </main>
    <dialog id="about-dialog"><button class="dialog-close" aria-label="Kapat"><svg><use href="#close"/></svg></button><img src="/brand/mark.svg?v=3" width="54" height="54" alt=""/><h2>Şarj durağını bul.<br/>Yoluna devam et.</h2><p>İstasyonları haritada keşfet, AC veya DC şarj türüne göre filtrele ve bir istasyon seçerek detaylarını gör.</p><p id="about-data-copy">{dataView.about}</p><button class="primary dialog-done">Keşfetmeye başla <svg><use href="#arrow"/></svg></button></dialog>
    <script src="../scripts/map.js"></script>
</BaseLayout>
