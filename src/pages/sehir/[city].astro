---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideSummary from '../../components/GuideSummary.astro';
import StationList from '../../components/StationList.astro';
import { dataset, stations, districtGroups } from '../../data/stations';
import { datasetPresentation, mapHref } from '../../lib/station-presentation.mjs';
import { districtPath } from '../../lib/station-guides.mjs';

export function getStaticPaths() {
  return [...new Map(stations.map((station) => [station.citySlug, station.city])).entries()]
    .map(([citySlug, city]) => ({ params: { city: citySlug }, props: { city, citySlug } }));
}
const { city, citySlug } = Astro.props;
const groups = districtGroups.filter((group) => group.citySlug === citySlug);
const cityStations = groups.flatMap((group) => group.stations);
const dataView = datasetPresentation(dataset);
const breadcrumbs = [{ name: 'şarj.ist', path: '/' }, { name: 'Şehir rehberi', path: '/sehir/' }, { name: city, path: `/sehir/${citySlug}/` }];
---
<BaseLayout title={`${city} elektrikli araç şarj istasyonları | şarj.ist`} description={`${city} şarj istasyonlarını ilçeye göre bul. Operatör, AC/DC, kayıtlı güç ve erişim bilgilerini incele; haritada aç.`} canonicalPath={`/sehir/${citySlug}/`} breadcrumbs={breadcrumbs}>
  <SiteHeader current="city" />
  <main class="content-page city-page">
    <Breadcrumbs items={breadcrumbs} />
    <a class="back-link" href={mapHref(citySlug)}>← {city} haritasına dön</a>
    <header class="city-heading"><h1>{city} şarj istasyonları</h1><p>{cityStations.length} {dataView.isSample ? 'örnek istasyon' : 'istasyon'} · {groups.length} ilçe grubu · Anlık müsaitlik gösterilmez.</p></header>
    <GuideSummary stations={cityStations} />
    <section class="guide-section"><h2>İlçeye göre şarj istasyonları</h2>
      <div class="district-grid">{groups.map((group) => <a class="district-link" href={districtPath(group)}><strong>{group.name}</strong><span>{group.stations.length} istasyon →</span></a>)}</div>
    </section>
    <section class="guide-section"><h2>İstasyondan örnekler</h2><p>Tüm istasyonlara yukarıdaki ilçe rehberlerinden ulaşabilirsin.</p><StationList stations={cityStations.slice(0, 12)} /></section>
    {dataView.isSample && <div class="sample-warning"><strong>{dataView.warningTitle}</strong><p>{dataView.warningText}</p></div>}
  </main>
</BaseLayout>
