---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { dataset, stations, type Station } from '../../data/stations';
import { datasetPresentation, operatorBadgeLabel, stationLocationUrl } from '../../lib/station-presentation.mjs';

export function getStaticPaths() {
  return stations.map((station) => ({ params: { slug: station.slug }, props: { station } }));
}

interface Props { station: Station }
const { station } = Astro.props;
const description = `${station.area} bölgesindeki ${station.operator} ${station.type} şarj noktası: ${station.power} kW azami güç ve ${station.sockets} soket.`;
const dataView = datasetPresentation(dataset);
---
<BaseLayout title={`${station.name} — ${station.city} | şarj.ist`} description={description} canonicalPath={`/istasyon/${station.slug}/`} breadcrumbs={[{ name: 'şarj.ist', path: '/' }, { name: 'Şehir rehberi', path: '/sehir/' }, { name: station.city, path: `/sehir/${station.citySlug}/` }, { name: station.name, path: `/istasyon/${station.slug}/` }]}>
  <SiteHeader current="station" />
  <main class="content-page">
    <a class="back-link" href={`/?sehir=${station.citySlug}`}>← {station.city} haritasına dön</a>
    <article class="station-page">
      <div class="page-heading">
        <span class="operator-mark" aria-label={station.operator} title={station.operator}>{operatorBadgeLabel(station.operator)}</span>
        <div>
          <p class="page-kicker">{station.operator} · {station.access}</p>
          <h1>{station.name}</h1>
          <p>{station.area}, {station.city}</p>
        </div>
      </div>
      <dl class="station-facts">
        <div><dt>Şarj türü</dt><dd>{station.type === 'DC' ? 'DC CCS' : 'AC Tip 2'}</dd></div>
        <div><dt>Azami güç</dt><dd>{station.power} kW</dd></div>
        <div><dt>Soket sayısı</dt><dd>{station.sockets} soket</dd></div>
        <div><dt>Erişim</dt><dd>{station.access}</dd></div>
      </dl>
      {dataView.isSample && <div class="sample-warning"><strong>{dataView.warningTitle}</strong><p>{dataView.warningText}</p></div>}
      <div class="page-actions">
        {!dataView.isSample && <a class="primary page-action" id="station-location-link" href={stationLocationUrl(station)} data-name={station.name} data-lat={station.lat} data-lng={station.lng} target="_blank" rel="noopener noreferrer">Konumu aç</a>}
        <a class="primary page-action secondary-action" href={`/sehir/${station.citySlug}/`}>{station.city} şarj istasyonlarını incele</a>
      </div>
    </article>
  </main>
</BaseLayout>
<script>
  import { openStationLocation } from '../../lib/station-presentation.mjs';

  const link = document.querySelector('#station-location-link');
  link?.addEventListener('click', (event) => {
    const station = {
      name: link.dataset.name,
      lat: Number(link.dataset.lat),
      lng: Number(link.dataset.lng),
    };
    openStationLocation(event, station);
  });
</script>
